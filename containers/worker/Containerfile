# The worker image every contained pass runs in (specs/003-sdd-model-routing,
# contracts/pass.md, research R5, R6). Built by `sdd-step prepare-worker` and
# tagged with this directory's hash, so a change here builds a new image.
# Apple Silicon only, as the rest of this repository: the downloaded artifacts
# below are the arm64 ones, checked against hashes recorded here.
#
# Every input is pinned by hash (FR-032, research R26): the base by digest,
# Debian packages from the base's own archive snapshot at exact versions, npm
# packages from package-lock.json, mise and uv by checksum. Bit-identical
# images are out of reach with Apple's builder (R26), so prepare-worker checks
# each build's installed packages against inventory.txt instead.

# node:24-bookworm-slim, the multi-arch index digest read 2026-10-21 (the tag
# moved twice that day; drift.sh's report caught both).
FROM docker.io/library/node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205

# The Debian archive snapshot the base image was built from, as its own
# /etc/apt/sources.list.d/debian.sources names it: packages added here come
# from the same moment, so they agree with what the base installed.
ARG DEBIAN_SNAPSHOT=20261020T213255Z

# Versions read 2026-10-21, each upstream's latest then: mise and uv, their
# hashes confirmed against the checksums each release publishes. The agents'
# versions are in package.json. drift.sh reports any pin, and the base's
# digest and the snapshot's age, once upstream moves on.
ARG MISE_VERSION=2026.10.17
ARG MISE_SHA256=cac510e51793ad45e65fe92305bdbe4309c9c60b5907badbc7eba111738ab08f
ARG UV_VERSION=0.13.4
ARG UV_SHA256=1ae72b4718729e2ccc4f1ae2c6d1e531ca8467800e0546e9130b3886023a60ab

# iptables for the firewall; python3 and openssl for the egress proxy, which
# runs on this image and makes the run's certificate authority with openssl
# (research R23, R25); ca-certificates for the system store the entrypoint
# adds that authority to, and curl for the downloads below. setpriv, which
# drops to node, is in util-linux, already in the base. The rest is what the
# agents and Spec Kit call (checks/92: rg and fd for pi's grep and find, which
# otherwise download them at run time; jq and PyYAML for Spec Kit's scripts;
# xz and unzip for mise; make and ps for check commands). No git: the export
# has no history, and without it no pass has a push client. No ipset or resolver:
# the firewall allows one address.
#
# Plain HTTP, as Debian's own sources: apt verifies every Release file's
# signature with the base's debian-archive-keyring. check-valid-until=no,
# because a snapshot's Release files carry the Valid-Until of their day and
# apt would refuse a pinned snapshot a week later; the signature still holds.
RUN rm -f /etc/apt/sources.list.d/debian.sources \
  && printf '%s\n' \
    "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm main" \
    "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm-updates main" \
    "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT} bookworm-security main" \
    > /etc/apt/sources.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends \
    iptables=1.8.9-2 python3=3.11.2-1+b1 openssl=3.0.22-1~deb12u1 \
    ca-certificates=20250419~deb12u2 curl=7.88.1-10+deb12u15 \
    ripgrep=13.0.0-4+b2 fd-find=8.6.0-3 jq=1.6-2.1+deb12u3 python3-yaml=6.0-3+b2 \
    xz-utils=5.4.1-1+deb12u2 unzip=6.0-28+deb12u1 make=4.3-4.1 procps=2:4.0.2-3 \
  && rm -rf /var/lib/apt/lists/*

RUN set -eu; cd /tmp \
  && curl -fsSL -o mise.tgz "https://github.com/jdx/mise/releases/download/v${MISE_VERSION}/mise-v${MISE_VERSION}-linux-arm64.tar.gz" \
  && echo "${MISE_SHA256}  mise.tgz" | sha256sum -c - \
  && tar -xzf mise.tgz && install -m 755 mise/bin/mise /usr/local/bin/mise \
  && curl -fsSL -o uv.tgz "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-aarch64-unknown-linux-gnu.tar.gz" \
  && echo "${UV_SHA256}  uv.tgz" | sha256sum -c - \
  && tar -xzf uv.tgz --strip-components=1 -C /usr/local/bin uv-aarch64-unknown-linux-gnu/uv uv-aarch64-unknown-linux-gnu/uvx \
  && rm -rf /tmp/*

# npm ci, from the lockfile's whole tree with its integrity hashes, into
# /opt/sdd, whose bins go on PATH by link. --ignore-scripts, so no install
# script from either dependency tree runs at build time. Claude Code's one
# script is then run by name: it copies the native binary npm already
# installed from an optional dependency over the `claude` placeholder,
# offline (read in install.cjs, 2026-10-21); without it `claude` only prints
# how to run it.
COPY package.json package-lock.json /opt/sdd/
RUN cd /opt/sdd \
  && npm ci --ignore-scripts --no-audit --no-fund \
  && node node_modules/@anthropic-ai/claude-code/install.cjs \
  && ln -s /opt/sdd/node_modules/.bin/claude /opt/sdd/node_modules/.bin/pi /usr/local/bin/ \
  && npm cache clean --force

COPY init-firewall.sh entrypoint.sh inventory.sh /usr/local/lib/sdd/

# pi's models.json exists, empty and owned by node, so the entrypoint (root)
# can write the pass's copy into it without changing its owner. Its content —
# the models, their prices, the proxy — is run governance, frozen in each
# run's bundle (claude/speckit/pi-models.json), not part of the image.
RUN chmod 755 /usr/local/lib/sdd/init-firewall.sh /usr/local/lib/sdd/entrypoint.sh /usr/local/lib/sdd/inventory.sh \
  && install -d -o node -g node /home/node/.pi /home/node/.pi/agent /work \
  && install -m 644 -o node -g node /dev/null /home/node/.pi/agent/models.json

WORKDIR /work
# Root, for the firewall; the entrypoint drops to node before the command.
USER root
ENTRYPOINT ["/usr/local/lib/sdd/entrypoint.sh"]
