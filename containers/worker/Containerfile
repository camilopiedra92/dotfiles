# The worker image every contained pass runs in (specs/003-sdd-model-routing,
# contracts/pass.md, research R5, R6). Built by `sdd-step prepare-worker` and
# tagged with this directory's hash, so a change here builds a new image.
# Apple Silicon only, as the rest of this repository: the downloaded artifacts
# below are the arm64 ones, checked against hashes recorded here.

# node:24-bookworm-slim, the multi-arch index digest read 2026-10-21 (the tag
# moved that day; drift.sh's report caught the first pin).
FROM docker.io/library/node:24-bookworm-slim@sha256:8cabefbd444809cf0e319b5831c65da1ea202200ca552a5e75fd7938a6f86658

# Versions read 2026-10-21, each upstream's latest then: Claude Code (also
# this machine's), pi (the package research R6 names), mise and uv, their
# hashes confirmed against the checksums each release publishes. drift.sh
# reports any of them, and the base's digest, once upstream moves on.
ARG CLAUDE_CODE_VERSION=2.1.306
ARG PI_VERSION=1.3.0
ARG MISE_VERSION=2026.10.17
ARG MISE_SHA256=cac510e51793ad45e65fe92305bdbe4309c9c60b5907badbc7eba111738ab08f
ARG UV_VERSION=0.13.4
ARG UV_SHA256=1ae72b4718729e2ccc4f1ae2c6d1e531ca8467800e0546e9130b3886023a60ab

# iptables for the firewall; python3 for the egress proxy, which runs on this
# image (research R23); ca-certificates and curl for the downloads below and
# for the toolchain's own. setpriv, which drops to node, is in util-linux,
# already in the base. No ipset or resolver: the firewall allows one address.
RUN apt-get update \
  && apt-get install -y --no-install-recommends iptables python3 ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

RUN set -eu; cd /tmp \
  && curl -fsSL -o mise.tgz "https://github.com/jdx/mise/releases/download/v${MISE_VERSION}/mise-v${MISE_VERSION}-linux-arm64.tar.gz" \
  && echo "${MISE_SHA256}  mise.tgz" | sha256sum -c - \
  && tar -xzf mise.tgz && install -m 755 mise/bin/mise /usr/local/bin/mise \
  && curl -fsSL -o uv.tgz "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-aarch64-unknown-linux-gnu.tar.gz" \
  && echo "${UV_SHA256}  uv.tgz" | sha256sum -c - \
  && tar -xzf uv.tgz --strip-components=1 -C /usr/local/bin uv-aarch64-unknown-linux-gnu/uv uv-aarch64-unknown-linux-gnu/uvx \
  && rm -rf /tmp/*

# --ignore-scripts, so no install script from either dependency tree runs at
# build time. Claude Code's one script is then run by name: it copies the
# native binary npm already installed from an optional dependency over the
# `claude` placeholder, offline (read in install.cjs, 2026-10-21); without it
# `claude` only prints how to run it.
RUN npm install -g --ignore-scripts "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" "@earendil-works/pi-coding-agent@${PI_VERSION}" \
  && node /usr/local/lib/node_modules/@anthropic-ai/claude-code/install.cjs \
  && npm cache clean --force

COPY init-firewall.sh entrypoint.sh models.json egress-registries.txt /usr/local/lib/sdd/

# pi's models.json exists owned by node, so the entrypoint (root) can write
# the proxy's URL into it without changing its owner.
RUN chmod 755 /usr/local/lib/sdd/init-firewall.sh /usr/local/lib/sdd/entrypoint.sh \
  && install -d -o node -g node /home/node/.pi /home/node/.pi/agent /work \
  && install -m 644 -o node -g node /usr/local/lib/sdd/models.json /home/node/.pi/agent/models.json

WORKDIR /work
# Root, for the firewall; the entrypoint drops to node before the command.
USER root
ENTRYPOINT ["/usr/local/lib/sdd/entrypoint.sh"]
