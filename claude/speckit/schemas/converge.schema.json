{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dotfiles:sdd:converge:1",
  "title": "A convergence pass",
  "type": "object",
  "properties": {
    "schema": {
      "const": "urn:dotfiles:sdd:converge:1"
    },
    "step": {
      "const": "converge"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "enum": [
        "converged",
        "tasks_appended"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "severity",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "step",
    "at",
    "outcome",
    "findings"
  ],
  "additionalProperties": false
}
