# One definition of formatting, read by everything that touches these files:
# shfmt (which parses .editorconfig natively when no flags override it), VS Code
# through the EditorConfig extension already in the Brewfile, and any editor
# anyone else opens the repo with. Encoding it here rather than in tool flags is
# what keeps the editor and the pre-commit hook from disagreeing.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Two spaces and spaces-not-tabs is the Google Shell Style Guide, which is the
# closest thing shell has to a universal convention.
#
# The shfmt-specific keys below are ignored by editors that do not know them:
# indent switch cases, and put a space after a redirect operator.
[*.sh]
indent_style = space
indent_size = 2
switch_case_indent = true
space_redirects = true

# git hooks are shell too, but cannot carry a .sh extension: git executes them
# by their exact name. This has to be a section of its own rather than joining
# the one above, because an EditorConfig pattern containing a slash is matched
# relative to this file — folding them together would silently stop *.sh from
# covering claude/*.sh.
[githooks/*]
indent_style = space
indent_size = 2
switch_case_indent = true
space_redirects = true

# Tabs are syntax here, not style: git's config parser and Make both require
# them, so an editor that "helpfully" converts them breaks the file.
#
# Matched by path rather than by name because the XDG filename is just
# "config", which on its own would also catch any other file called that.
[git/config]
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
