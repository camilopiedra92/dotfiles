# Linked to ~/.ssh/config by install.sh. Only what every host needs; a host
# with its own key or user gets its own block, on the machine, in
# ~/.ssh/config.local -- which is why the Include comes first: ssh takes the
# first value it finds for an option, so that block's User wins. IdentityFile
# is the exception: it accumulates, so the host's own key is tried first and
# the one below is still offered after it. Nothing in config.local can take
# it away, because Host * matches every host; a host that must never see it
# needs the pattern here to exclude it, as `Host * !name`.
Include config.local

Host *
  # Load keys into the agent on first use and remember the passphrase in
  # the Keychain, so it is typed once per machine and never per push. Both
  # act only when ssh runs, and git here goes over HTTPS, so for signing
  # the agent is filled at login instead: see launchd/ and install.sh 4c.
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
