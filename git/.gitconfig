# Identidad: vive en ~/.gitconfig.local (fuera del repo).
# Asi este repo puede ser publico y cada maquina usa su propio nombre/email.
[include]
	path = ~/.gitconfig.local

[init]
	defaultBranch = main

[push]
	# Crea la rama remota sola en el primer push, sin --set-upstream
	autoSetupRemote = true

[pull]
	# Rebase en vez de merge: historial lineal, sin commits de merge basura
	rebase = true

[fetch]
	# Borra ramas locales que ya no existen en el remoto
	prune = true
	pruneTags = true

[rebase]
	autoSquash = true
	autoStash = true

[merge]
	# Muestra tambien el estado original en los conflictos, no solo los dos lados
	conflictStyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default

[branch]
	# git branch ordena por commit mas reciente, no alfabeticamente
	sort = -committerdate

[column]
	ui = auto

[core]
	excludesfile = ~/.gitignore_global

[help]
	# Corrige typos ("git stauts") tras 1s en vez de solo sugerir
	autocorrect = prompt

# Escrito por `gh auth setup-git`. gh entrega el token a git, asi que no hay
# credenciales guardadas aqui ni contrasenas que teclear en push/pull.
# El "helper =" vacio limpia los helpers heredados antes de poner el suyo.
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
