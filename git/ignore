# macOS, from github/gitignore Global/macOS.gitignore.
#
# The Finder writes the custom-folder-icon file as "Icon" plus a carriage
# return. Upstream matches it with a literal CR inside a bracket, which is a
# byte no editor here will preserve reliably; [[:cntrl:]] is the same match
# written in characters. Not `Icon?`, which the old file used: that also
# matches anything five characters long starting with Icon, so a project with
# an `Icons` directory would lose it with no error to explain why.
.DS_Store
.localized
__MACOSX/
.AppleDouble
.LSOverride
Icon[[:cntrl:]]

